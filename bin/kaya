#!/usr/bin/env bash
# The `kaya` command. install.sh symlinks this onto your PATH; it finds the checkout
# through the symlink, so the tool, config and state all stay in this folder.
set -euo pipefail
self="$(readlink -f "${BASH_SOURCE[0]}")"
root="$(cd "$(dirname "$self")/.." && pwd)"
py="${KAYA_PYTHON:-python3}"
if ! "$py" -c 'import sys; sys.exit(sys.version_info < (3, 11))' 2>/dev/null; then
    echo "kaya needs Python 3.11 or newer; '$py' is too old or missing. Point KAYA_PYTHON at a newer one." >&2
    exit 1
fi
# -P keeps the current folder off sys.path, so a project's own json.py (say) can't
# shadow the standard library.
PYTHONPATH="$root/src${PYTHONPATH:+:$PYTHONPATH}" exec "$py" -P -m kaya_tools "$@"
